GOLANG_API_BASE_URL=http://localhost:8080/api
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000
SERVICE_ENV=development
FORECAST_HORIZON_DAYS=30
RETRAIN_INTERVAL_DAYS=7
LOG_LEVEL=INFO

# =====================
# Forecast Runtime / Visitors Scheduler
# =====================
# manual = scheduler mati; scheduler = auto visitors scheduler aktif
FORECAST_MODE=manual
FORECAST_SCHEDULER_TIMEZONE=Asia/Jakarta
FORECAST_AFTER_CLOSE_SCHEDULER_MINUTES=60
FORECAST_24H_RUN_SCHEDULER_MINUTES=120
FORECAST_SCHEDULER_CHECK_INTERVAL_MINUTES=15
SCHEDULER_RETRAIN=true


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=potsgres
DB_SSLMODE=disable

# Internal backend route for forecast-service without user login.
# Use /internal/forecast when backend INTERNAL_SERVICE_KEY is enabled.
BACKEND_API_URL=http://localhost:8080/internal/forecast
GOLANG_API_BASE_URL=http://localhost:8080/internal/forecast
INTERNAL_SERVICE_KEY=
BACKEND_REQUEST_TIMEOUT_SECONDS=30
