GOLANG_API_BASE_URL=http://localhost:8080/api
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000
SERVICE_ENV=development
MODEL_DIR=../../models/visitors
FORECAST_HORIZON_DAYS=30
RETRAIN_INTERVAL_DAYS=7
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sora_finance
DB_SSLMODE=disable

# Forecast execution control
# manual: scheduler mati; gunakan endpoint /api/forecast/{module}/run untuk test manual.
# scheduler: scheduler aktif bila ENABLE_FORECAST_SCHEDULER=true.
FORECAST_MODE=manual
ENABLE_FORECAST_SCHEDULER=false
FORECAST_RUN_AFTER_CLOSE_MINUTES=60
FORECAST_24H_RUN_TIME=02:00
BACKEND_REQUEST_TIMEOUT_SECONDS=30
