APP_ENV=development
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=sora_app
DB_PASSWORD=change-me
DB_NAME=sora_finance
DB_SSLMODE=disable

JWT_SECRET=change-me-use-at-least-32-random-characters
REDIS_URL=

# Comma-separated origins. Required in production, example:
# ALLOWED_ORIGINS=https://app.sorafinance.com,https://admin.sorafinance.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Keep disabled in production unless intentionally protected by network/auth.
ENABLE_SWAGGER=true
ENABLE_TEST_ROUTES=false

# Internal machine-to-machine key for forecast-service -> backend.
# Must match forecast-service INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=change-me-internal-service-key-min-32-chars
